# Copie para .env e ajuste. Nunca coloque valores reais neste arquivo.
DB_PATH=data/b3.db
LOG_LEVEL=INFO
LOG_DIR=logs
# Coleta (etapa 2)
RAW_DIR=data/raw
HISTORICO_ANOS=5
# Etapa 3.4: chave gratuita em https://aistudio.google.com (Get API key). Valor real só no .env
GEMINI_API_KEY=
# Modelo do Gemini para extração de eventos (padrão: gemini-3.5-flash-lite)
GEMINI_MODELO=gemini-3.5-flash-lite

# Etapa 7: API local. Token longo e aleatório que as interfaces (app e site) enviam.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Origens do site autorizadas a chamar a API (CORS), separadas por vírgula
API_ORIGENS=http://localhost:5173

# Etapa 7: carteira real na XP via Meu Pluggy (Open Finance). Passo a passo em src/coleta/pluggy.py.
# Nunca a senha da corretora: só as credenciais da API da Pluggy e o Item ID da conexão.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=

# Etapa 8: nuvem. Vazio = SQLite local. Com valor, a API lê do Postgres (Neon).
# Em produção fica nos segredos do GitHub e no painel do Render, nunca aqui (passo a passo em DEPLOY.md).
DATABASE_URL=
# App desktop: endereço da API (vazio = tenta 127.0.0.1:8000). O app também guarda isso no menu "Conexão…".
API_URL=
